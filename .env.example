# Copy to .env and fill in. Never commit .env.
# Gemini: https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=
# Firecrawl: https://firecrawl.dev -> sign up -> API keys
FIRECRAWL_API_KEY=
# Optional: model override (check AI Studio for the current free Flash model)
GEMINI_MODEL=gemini-3.5-flash
